  // =================== categories: the name and the claim each one makes
  "category.performance.name": "Performance",
  "category.performance.promise": "Raises the FPS and evens out frametimes, by giving the game CPU, GPU or memory that Windows was spending on something else.",
  "category.input-lag.name": "Input Lag & Aim",
  "category.input-lag.promise": "Shortens or steadies the path from your mouse and keyboard to the screen, so the same movement always produces the same result.",
  "category.ping.name": "Ping",
  "category.ping.promise": "Cuts round-trip network latency, or stops Windows adding delay of its own to traffic the game is waiting on.",
  "category.stability.name": "Crashes & Freezes",
  "category.stability.promise": "Fixes a specific fault that shows up while playing: driver timeouts, black screens, flicker. Repairs a broken machine rather than making a working one faster.",
  "category.interruptions.name": "Interruptions",
  "category.interruptions.promise": "Stops things appearing over what you are doing, stealing focus, or restarting the machine at a moment you did not choose.",
  "category.telemetry.name": "Telemetry & Privacy",
  "category.telemetry.promise": "Stops Windows collecting, identifying and uploading what you do. Nothing here is about speed, and none of it is a substitute for the privacy settings Windows already offers.",
  "category.startup.name": "Startup & Boot",
  "category.startup.promise": "Shortens the gap between signing in and a machine that is actually ready, by removing work Windows schedules for itself in those first minutes.",
  "category.unused.name": "Unused Features",
