<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Nostos.Tweaks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nostos.Core\Nostos.Core.csproj" />
    <ProjectReference Include="..\Nostos.Win32\Nostos.Win32.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The whole catalog: registry.json, services.json, adapters.json. Embedded only, and
         matched by name prefix at load time, so a new file needs a loader rather than only a
         drop into this folder.

         Embedded rather than copied beside the executable because a binary should be
         self-describing: whatever it says the catalog is, is what it will do. A loose file
         would also stop a single-file build from being a single file. -->
    <EmbeddedResource Include="Catalog\*.json" />
  </ItemGroup>
</Project>
