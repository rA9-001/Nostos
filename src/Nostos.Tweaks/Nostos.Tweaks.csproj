<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Nostos.Tweaks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nostos.Core\Nostos.Core.csproj" />
    <ProjectReference Include="..\Nostos.Win32\Nostos.Win32.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The catalog ships inside the assembly so a single binary is self-describing,
         and is also copied out so users can read it without unpacking anything. -->
    <!-- Embedded only. RegistryTweakCatalog.LoadEmbedded reads these out of the assembly, so
         a copy next to the executable would never be read and would stop a single-file build
         from being a single file. -->
    <EmbeddedResource Include="Catalog\*.json" />
  </ItemGroup>
</Project>
