<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ======================================================================= shared ===

       The vocabulary the views are written in: a handful of classes for surfaces, text and
       chips, plus the two motions this window uses.

       Every view in the app is built out of these rather than out of literal colours and
       radii. That is what keeps the look consistent for free: a panel is a panel because it
       says Classes="panel", so there is exactly one place to change what a panel looks like.

       Controls with a full template of their own are in Controls.axaml.                      -->

  <!-- ===================================================================== surfaces -->

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerPanel}" />
  </Style>

  <!-- A panel inside a panel: same shape, no border, so nesting does not produce a stack of
       concentric outlines. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceFlat}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeSoft}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerCard}" />
  </Style>

  <!-- Recessed: registry values, paths, anything quoted back from the machine. -->
  <Style Selector="Border.inset">
    <Setter Property="Background" Value="{DynamicResource SurfaceInset}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeSoft}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerControl}" />
    <Setter Property="Padding" Value="11,9" />
  </Style>

  <!-- ======================================================================== rows ==

       The catalog and the journal draw their own row surface instead of letting the list
       highlight the whole container, because a row carries its section heading inside it and
       a highlight that swallows the heading makes the list look broken.

       Hover and selection are set from the container's pseudo classes, which is why these are
       styles on a class rather than bindings: no converter, no extra view model property, and
       the transition on the row itself does the fading.                                      -->

  <Style Selector="Border.row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerCard}" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ListBoxItem:pointerover Border.row">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeSoft}" />
  </Style>

  <Style Selector="ListBoxItem:selected Border.row">
    <Setter Property="Background" Value="{DynamicResource AccentTint}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>

  <!-- ======================================================================= pills ==

       The sidebar's category rows. Same trick as the catalog's rows and for the same reason:
       the container draws nothing and the item template draws the pill, so the group heading
       a row carries above its name stays outside the highlight.

       The bar down the left edge does the work a tick would do in a wider list.             -->

  <Style Selector="Border.pill">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerControl}" />
    <Setter Property="Padding" Value="0,8" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.pillbar">
    <Setter Property="Width" Value="3" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.pill TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>

  <Style Selector="ListBoxItem:pointerover Border.pill">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
  </Style>
  <Style Selector="ListBoxItem:pointerover Border.pill TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="ListBoxItem:selected Border.pill">
    <Setter Property="Background" Value="{DynamicResource AccentTint}" />
  </Style>
  <Style Selector="ListBoxItem:selected Border.pill TextBlock">
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ListBoxItem:selected Border.pillbar">
    <Setter Property="Background" Value="{DynamicResource AccentBright}" />
  </Style>

  <!-- ===================================================================== banners ==

       Three tints for the three things a banner can be: something new, something missing,
       something wrong. Each is a translucent wash of its own colour with a matching outline,
       so a banner reads as coloured light on the window rather than as a coloured slab.      -->

  <Style Selector="Border.banner">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerCard}" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>

  <Style Selector="Border.banner.info">
    <Setter Property="Background" Value="{DynamicResource InfoTint}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InfoStroke}" />
  </Style>
  <Style Selector="Border.banner.warn">
    <Setter Property="Background" Value="{DynamicResource WarningTint}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WarningStroke}" />
  </Style>
  <Style Selector="Border.banner.danger">
    <Setter Property="Background" Value="{DynamicResource DangerTint}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerStroke}" />
  </Style>

  <!-- ======================================================================== text -->

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <!-- The small capitals that label a group of things. Tracked out, because capitals set at
       11px with normal spacing read as a solid block rather than as words. -->
  <Style Selector="TextBlock.section">
    <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.2" />
  </Style>

  <!-- Anything quoted verbatim from the machine: registry values, ids, paths. -->
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>

  <!-- ======================================================================= chips ==

       A chip is a fact about one row, small enough to sit at the end of it: risk, evidence,
       whether the app manages it. Filled with a wash of its own colour rather than outlined,
       which at this size stays readable where a 1px outline turns into a smudge.             -->

  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="{DynamicResource CornerPill}" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
  </Style>

  <Style Selector="TextBlock.chiptext">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.4" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- ==================================================================== controls ==

       Templates for these stay Fluent's; only the shape and the colours change. The parts
       that matter for behaviour, a text box's caret and selection and placeholder among them,
       are worth more than a bespoke template.                                                -->

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceInset}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerControl}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentTint}" />
    <Setter Property="CaretBrush" Value="{DynamicResource AccentBright}" />
    <Setter Property="Padding" Value="11,8" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <!-- A text box that is only the typing part of a field: the border, the icon and the
       padding belong to the Border wrapped around it. -->
  <Style Selector="TextBox.bare">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="Border.field">
    <Setter Property="Background" Value="{DynamicResource SurfaceInset}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerControl}" />
    <Setter Property="Padding" Value="11,8" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.field:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrong}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceInset}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerControl}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Background" Value="{DynamicResource SurfaceInset}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerPill}" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="ScrollViewer">
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
  </Style>

  <!-- A thin translucent thumb rather than a grey bar. Translucent so it works over a panel
       and over the window alike, and rounded so it matches everything else it sits beside. -->
  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="#2EFFFFFF" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerPill}" />
  </Style>
  <Style Selector="ScrollBar:pointerover /template/ Thumb">
    <Setter Property="Background" Value="#59FFFFFF" />
  </Style>

  <!-- ==================================================================== motion ===

       Two loops and one entrance. Deliberately few: a window where several things move at
       once has no way to say that one of them matters.                                      -->

  <!-- Work in progress on a single row. A dashed ring on a continuous rotation, because
       Avalonia has no ring progress control and a straight indeterminate bar reads as "the
       whole window is busy", which is the wrong message for one row out of eighty four. -->
  <Style Selector="Ellipse.spinner">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeDashArray" Value="3.2,2.2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="Stroke" Value="{DynamicResource AccentBright}" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="INFINITE" Easing="LinearEasing">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- The live indicator: a slow breath rather than a spin, so a healthy idle window is calm
       and it is the absence of the pulse that draws the eye. -->
  <Style Selector="Ellipse.pulse">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Fill" Value="{DynamicResource Success}" />
    <Style.Animations>
      <Animation Duration="0:0:2.4" IterationCount="INFINITE" Easing="SineEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1.0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- A page arriving: up eight pixels and in, over a quarter second. Short enough that it
       never delays a reader who knows where they are going. -->
  <Style Selector=":is(UserControl).page">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Style.Animations>
      <Animation Duration="0:0:0.26" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="8" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- A modal arriving: the scrim fades, the dialog rises into it. -->
  <Style Selector="Border.scrim">
    <Setter Property="Background" Value="{DynamicResource Scrim}" />
    <Style.Animations>
      <Animation Duration="0:0:0.18" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Border.dialog">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="BoxShadow" Value="0 24 60 -20 #CC000000" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Style.Animations>
      <Animation Duration="0:0:0.24" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="14" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- ============================================================== window buttons ==

       Minimise, maximise and close, drawn by the app because the system title bar is gone.

       Shaped like the rest of the window rather than like Windows' own square 46x32 buttons:
       the point of taking the title bar over was to stop the top of the window looking like it
       belonged to a different program.

       Close goes red on hover and the other two do not. That is the one piece of the system
       chrome's behaviour worth keeping, because it is the only defence against a misclick on
       the button that ends the session.                                                       -->

  <Style Selector="Button.caption">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="Button.caption:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- No shrink on press. These three are the window's own controls, not the app's, and a
       close button that moves under the pointer is a close button that gets missed. -->
  <Style Selector="Button.caption:pressed">
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Background" Value="{DynamicResource SurfacePressed}" />
  </Style>

  <Style Selector="Button.caption Path">
    <Setter Property="Fill" Value="{DynamicResource Muted}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Fill" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.caption:pointerover Path">
    <Setter Property="Fill" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="Button.caption.close:pointerover">
    <Setter Property="Background" Value="{DynamicResource Danger}" />
  </Style>
  <Style Selector="Button.caption.close:pressed">
    <Setter Property="Background" Value="{DynamicResource DangerStroke}" />
  </Style>
  <Style Selector="Button.caption.close:pointerover Path">
    <Setter Property="Fill" Value="#FFFFFF" />
  </Style>

  <!-- The gear turns 45 degrees on hover, which is exactly one tooth on an eight tooth gear:
       it steps one notch rather than sliding to an arbitrary angle. Descendant rather than
       child, because a button wraps its content in a presenter. -->
  <Style Selector="Button.icon Path">
    <Setter Property="Fill" Value="{DynamicResource Muted}" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.35"
                                       Easing="CubicEaseOut" />
        <BrushTransition Property="Fill" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.icon:pointerover Path">
    <Setter Property="Fill" Value="{DynamicResource AccentBright}" />
    <Setter Property="RenderTransform" Value="rotate(45deg)" />
  </Style>

</Styles>
