<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Nostos.App.ViewModels"
        xmlns:views="using:Nostos.App.Views"
        xmlns:ipc="using:Nostos.Ipc"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:loc="using:Nostos.App.Localization"
        xmlns:startup="using:Nostos.App.Startup"
        x:Class="Nostos.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Nostos"
        WindowState="Maximized"
        Width="1180" Height="780"
        MinWidth="960" MinHeight="640"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="{DynamicResource TextPrimary}"
        Background="{DynamicResource WindowBackground}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True">

  <!-- The window keeps its frame, loses its title bar, and draws its own.

       Windows' bar is a strip in somebody else's colours across the top of a window that is
       otherwise all one piece, and no amount of theming reaches it. The strip at the bottom of
       this file replaces the three things it was doing: a place to grab the window, somewhere
       for its name, and the minimise, maximise and close buttons.

       It takes both settings, and each one alone was tried and was wrong:

         BorderOnly alone removes the title bar but leaves the top edge of the frame showing as
         a grey strip across the whole width of the window.

         ExtendClientAreaToDecorationsHint alone covers that strip, but leaves the title bar
         nominally present, so Avalonia draws caption buttons of its own and there are two sets
         in the corner.

       Together: no title bar for Avalonia to decorate, and the client area covers the frame.

       The frame itself is deliberately kept rather than turned off with WindowDecorations
       "None". That was measured, not assumed: "None" clears WS_THICKFRAME, and a window without
       that bit cannot be resized by dragging any of its edges. Snapping, the drop shadow and
       Windows 11's rounded corners go with it.

       OffScreenMargin is the last piece. A maximised window with an extended client area is
       deliberately a few pixels larger than the screen on every side so its borders fall out of
       view, and anything drawn at the very edge is cut off by exactly that much until the
       margin is allowed for. The title bar is drawn at the very edge.                         -->
  <Panel Margin="{Binding $parent[Window].OffScreenMargin}">

    <!-- ==================================================================== backdrop ==

         Two soft lights, violet at the top left and cyan at the top right, sitting behind
         everything at a few percent opacity. They are the reason the header does not look
         like text on a flat rectangle. Clipped and untouchable: this is scenery, and a
         pointer must never find it.                                                        -->
    <Panel ClipToBounds="True" IsHitTestVisible="False">
      <Border Width="1700" Height="1700" Background="{DynamicResource GlowViolet}"
              HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-720,-1000,0,0" />
      <Border Width="1500" Height="1500" Background="{DynamicResource GlowCyan}"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1020,-560,0" />
    </Panel>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="22,46,22,18">

      <!-- ================================================================== header ==

           The mark and the wordmark moved up into the title bar, where an app's identity
           belongs, so this row is now just the two facts that are true of the whole window
           and the three things that act on all of it.                                       -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,0,2,14">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7"
                    VerticalAlignment="Center">
          <Border Classes="chip">
            <TextBlock Classes="muted" FontSize="11" Text="{Binding ConnectionText}" />
          </Border>
          <Border Classes="chip">
            <TextBlock Classes="muted" FontSize="11" Text="{Binding OutstandingText}" />
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center">
          <Button Content="{loc:Tr app.refresh}" Command="{Binding RefreshCommand}" />
          <Button Classes="danger" Content="{loc:Tr app.revert.all}"
                  Command="{Binding RevertAllCommand}" />
          <Button Classes="icon ghost" Command="{Binding OpenSettingsCommand}"
                  ToolTip.Tip="{loc:Tr app.settings.tip}">
            <Path Data="{DynamicResource GearIcon}" Stretch="Uniform"
                  Width="18" Height="18" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- ================================================================ activity ==

           Always here, always the same height. Nothing about this panel appears or
           disappears; only its contents change, and they cross fade. A progress indicator
           that pops in and out shoves every panel below it down and back, and for work that
           finishes in 40ms that reads as a glitch rather than as progress. So the space is
           paid for once, up front, and it earns its keep when idle by holding the last
           result and the freshness clock.                                                  -->
      <Border Grid.Row="1" Classes="panel" Padding="16,13" Margin="0,0,0,12">
        <DockPanel>

          <!-- One fixed slot shared by the spinner and the idle dot, so neither moves the
               text beside it. -->
          <Panel DockPanel.Dock="Left" Width="22" Height="22" Margin="0,0,14,0"
                 VerticalAlignment="Center">
            <Ellipse Classes="spinner" Width="22" Height="22"
                     Opacity="{Binding IsWorking, Converter={StaticResource OpacityWhenTrue}}">
              <Ellipse.Transitions>
                <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.18" /></Transitions>
              </Ellipse.Transitions>
            </Ellipse>
            <Ellipse Classes="pulse" Width="9" Height="9"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Opacity="{Binding IsWorking, Converter={StaticResource OpacityWhenFalse}}">
              <Ellipse.Transitions>
                <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.18" /></Transitions>
              </Ellipse.Transitions>
            </Ellipse>
          </Panel>

          <Border DockPanel.Dock="Right" Classes="chip" VerticalAlignment="Center"
                  Margin="14,0,0,0" IsVisible="{Binding IsLive}">
            <TextBlock Classes="faint" Text="{Binding LastUpdatedText}" />
          </Border>

          <StackPanel Spacing="3">
            <TextBlock Text="{Binding ActivityTitle}" FontWeight="SemiBold" FontSize="14"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{Binding StatusIsError, Converter={x:Static views:BoolBrushes.ErrorNormal}}" />
            <TextBlock Text="{Binding ActivityDetail}" Classes="muted" FontSize="12"
                       TextTrimming="CharacterEllipsis" />

            <!-- Always present at a fixed height, so its arrival never resizes anything. It
                 only animates while it is being looked at. -->
            <ProgressBar Height="3" Margin="0,5,0,0"
                         IsIndeterminate="{Binding IsWorking}"
                         Opacity="{Binding IsWorking, Converter={StaticResource OpacityWhenTrue}}">
              <ProgressBar.Transitions>
                <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.18" /></Transitions>
              </ProgressBar.Transitions>
            </ProgressBar>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- ================================================================= banners -->
      <StackPanel Grid.Row="2">

        <!-- Update first: it is the only banner that offers something new, and it is the one
             a user is most likely to want to act on the moment they see it. -->
        <Border Classes="banner info" IsVisible="{Binding UpdateAvailable}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,1,15,1"
                    Background="{DynamicResource InfoText}" />
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
              <TextBlock Text="{Binding UpdateTitle}" FontWeight="SemiBold"
                         Foreground="{DynamicResource InfoText}" />
              <TextBlock Text="{Binding UpdateDetail}" TextWrapping="Wrap" Classes="muted" />
            </StackPanel>
            <Button Grid.Column="2" Classes="accent" Content="{loc:Tr banner.update.install}"
                    VerticalAlignment="Center" Margin="14,0,0,0"
                    Command="{Binding InstallUpdateCommand}" />
          </Grid>
        </Border>

        <Border Classes="banner warn" IsVisible="{Binding ShowSetupBanner}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,1,15,1"
                    Background="{DynamicResource WarningText}" />
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
              <TextBlock Text="{Binding SetupBannerTitle}" FontWeight="SemiBold"
                         Foreground="{DynamicResource WarningText}" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         IsVisible="{Binding ShowServiceExplanation}"
                         Text="{loc:Tr banner.service.explain}" />
              <TextBlock Classes="muted" Text="{Binding SetupNotice}" TextWrapping="Wrap"
                         IsVisible="{Binding HasSetupNotice}" />
            </StackPanel>
            <Button Grid.Column="2" Content="{Binding SetupActionLabel}"
                    VerticalAlignment="Center" Margin="14,0,0,0"
                    IsVisible="{Binding CanOfferServiceSetup}"
                    Command="{Binding EnableServiceCommand}" />
          </Grid>
        </Border>
      </StackPanel>

      <!-- ================================================================= content -->
      <TabControl Grid.Row="3">

        <TabItem Header="{loc:Tr tab.tweaks}">
          <views:TweaksView Classes="page" />
        </TabItem>

        <TabItem Header="{loc:Tr tab.profiles}">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Profiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProfileViewModel">
                  <Border Classes="panel" Padding="20" Margin="0,0,0,10">
                    <StackPanel Spacing="0">
                      <Grid ColumnDefinitions="*,Auto">

                        <!-- The whole header strip opens the card, not just the arrow: a
                             nine-pixel chevron is a fiddly hit target, and the card is what
                             the reader is looking at. A Button rather than a tapped handler so
                             it is reachable from the keyboard like everything else. -->
                        <Button Grid.Column="0" Classes="ghost" Padding="0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                IsEnabled="{Binding CanExpand}"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleProfileCommand}"
                                CommandParameter="{Binding}">

                          <!-- Capped rather than left to fill the window. These descriptions
                               are three or four lines of prose, and a line of prose 1,800
                               pixels wide is one the eye loses its place in on the way back
                               to the left. -->
                          <StackPanel Spacing="7" MaxWidth="900" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                              <Path Width="9" Height="9" Stretch="Uniform"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding CanExpand}"
                                    Fill="{DynamicResource Muted}"
                                    Data="{Binding ToggleGlyphKey,
                                                   Converter={StaticResource GeometryFromKey}}" />
                              <TextBlock Text="{Binding DisplayName}" Classes="title"
                                         VerticalAlignment="Center" />
                              <Border Classes="chip" VerticalAlignment="Center">
                                <TextBlock Classes="chiptext" Text="{Binding CountText}"
                                           Foreground="{DynamicResource Muted}" />
                              </Border>

                              <!-- How much of it this machine already matches. On the header
                                   rather than inside the card, because it changes what the
                                   Apply button is offering: "42 tweaks" and "38 of 42 already
                                   applied" are very different propositions. -->
                              <Border Classes="chip" VerticalAlignment="Center"
                                      IsVisible="{Binding HasAppliedText}"
                                      Background="{DynamicResource RiskSafeTint}">
                                <TextBlock Classes="chiptext" Text="{Binding AppliedText}"
                                           Foreground="{DynamicResource RiskSafe}" />
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                       Classes="muted" LineHeight="19" />
                          </StackPanel>
                        </Button>


                        <!-- Not the accent fill: three profiles are three equal choices, and a
                             screen with three primary buttons has none. -->
                        <Button Grid.Column="1" Content="{loc:Tr profiles.apply}"
                                VerticalAlignment="Center" Margin="20,0,0,0"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ApplyProfileCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>

                      <!-- Only while this card is being applied, and below the header rather
                           than inside it: laid over the header it painted a line straight
                           through the description, because the header is one row of a grid and
                           a bar bottom-aligned in that row lands on the prose.

                           Indeterminate until a real report arrives, and indeterminate for good
                           on a backend that cannot send one. A determinate bar that is never fed
                           reads "0 of 42" for the whole run and then jumps, which is a worse lie
                           than admitting to not knowing where it has got to. -->
                      <StackPanel Margin="0,14,0,0" Spacing="6" IsVisible="{Binding IsApplying}">
                        <ProgressBar Height="3" Minimum="0" Maximum="1"
                                     Value="{Binding ProgressFraction}"
                                     IsIndeterminate="{Binding !HasCountedProgress}" />
                        <TextBlock Classes="faint" FontSize="11"
                                   Text="{Binding ProgressText}"
                                   IsVisible="{Binding HasCountedProgress}" />
                      </StackPanel>

                      <!-- What it would apply. Inside the card rather than in a dialog: the
                           question it answers is "what am I agreeing to", and the Apply button
                           that asks it has to stay on screen while the answer is read. -->
                      <StackPanel IsVisible="{Binding IsExpanded}" Margin="0,16,0,0" Spacing="0">
                        <Border Classes="inset" Padding="4,8,14,10">

                          <!-- Grouped by category rather than listed flat. The flat version
                               repeated the category as a word on every one of forty-two rows,
                               which is a heading pretending to be a column: it said the same
                               thing four times running and gave the list no shape at all. -->
                          <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:ProfileCategoryGroup">
                                <StackPanel Margin="0,0,0,12" Spacing="1">

                                  <Grid ColumnDefinitions="*,Auto" Margin="14,0,0,6">
                                    <TextBlock Grid.Column="0" Classes="section"
                                               Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Classes="faint" FontSize="10"
                                               VerticalAlignment="Center"
                                               Text="{Binding CountText}" />
                                  </Grid>

                                  <ItemsControl ItemsSource="{Binding Tweaks}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="vm:ProfileTweakViewModel">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,3"
                                              Opacity="{Binding RowOpacity}">
                                          <Grid.Transitions>
                                            <Transitions>
                                              <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                                            </Transitions>
                                          </Grid.Transitions>

                                          <!-- Marks the row being worked on right now. A bar
                                               rather than a highlight: forty rows going past
                                               is something the eye should be able to follow
                                               without reading any of them. -->
                                          <Border Grid.Column="0" Width="2" Height="16"
                                                  CornerRadius="1" Margin="0,0,4,0"
                                                  VerticalAlignment="Center"
                                                  IsVisible="{Binding IsRunning}"
                                                  Background="{DynamicResource AccentBright}" />

                                          <!-- The glyph and the spinner share a cell. While a
                                               row is being applied its state is not knowable,
                                               and a stale tick beside a spinner invites the
                                               reader to believe it. -->
                                          <Panel Grid.Column="1" Width="26"
                                                 VerticalAlignment="Center">
                                            <TextBlock FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding HasGlyph}"
                                                       Text="{Binding StateGlyph}"
                                                       Foreground="{Binding StateBrushKey,
                                                                            Converter={StaticResource BrushFromKey}}" />
                                            <Ellipse Classes="spinner" IsVisible="{Binding IsRunning}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                                          </Panel>

                                          <TextBlock Grid.Column="2" Text="{Binding Title}"
                                                     TextTrimming="CharacterEllipsis"
                                                     VerticalAlignment="Center" />

                                          <Border Grid.Column="3" Classes="chip"
                                                  VerticalAlignment="Center" Margin="10,0,0,0"
                                                  Background="{Binding RiskBrushKey,
                                                                       Converter={StaticResource BrushFromKey},
                                                                       ConverterParameter=Tint}">
                                            <TextBlock Classes="chiptext" Text="{Binding RiskText}"
                                                       Foreground="{Binding RiskBrushKey,
                                                                            Converter={StaticResource BrushFromKey}}" />
                                          </Border>
                                        </Grid>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Border>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{loc:Tr tab.startup}">
          <views:StartupView Classes="page" />
        </TabItem>

        <!-- After Startup, because both are pages about what Windows does on its own rather
             than pages of catalog. Its rows are the same view models the Tweaks tab holds, so
             switching one here shows there too. -->
        <TabItem Header="{loc:Tr tab.updates}">
          <views:UpdatesView Classes="page" />
        </TabItem>

        <TabItem Header="{loc:Tr tab.history}">
          <views:HistoryView Classes="page" />
        </TabItem>
      </TabControl>

    </Grid>

    <!-- ============================================================ setup overlay ==

         Everything the user would otherwise have had to do by hand happens behind this
         panel: folders, default profiles, service install, connection.                     -->
    <Border Classes="scrim" IsVisible="{Binding IsSettingUp}">
      <Border Classes="dialog" Padding="30" Width="460"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="18">
          <StackPanel Spacing="5">
            <TextBlock Text="{loc:Tr setup.title}" FontSize="20" FontWeight="Bold" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="{loc:Tr setup.detail}" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding SetupSteps}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="startup:StartupStep">
                <Grid ColumnDefinitions="26,*" Margin="0,5">
                  <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontSize="14"
                             VerticalAlignment="Center"
                             Foreground="{Binding Status, Converter={x:Static views:StepBrushes.ForStatus}}" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Title}" />
                    <TextBlock Text="{Binding Detail}" Classes="faint" TextWrapping="Wrap"
                               IsVisible="{Binding Detail, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ProgressBar IsIndeterminate="True" Height="3" />
        </StackPanel>
      </Border>
    </Border>

    <!-- ========================================================= settings overlay ==

         An overlay rather than a fourth tab. Everything in the tab strip is about the
         machine; these two things are about the program, and one of them deletes it.       -->
    <Border Classes="scrim" IsVisible="{Binding ShowSettings}">
      <Border Classes="dialog" Width="700" MaxHeight="760" Margin="0,26"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              ClipToBounds="True">
        <DockPanel>

          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="24,20,16,14">
            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="11"
                    Background="{DynamicResource AccentTint}" VerticalAlignment="Center"
                    Margin="0,0,13,0">
              <Path Data="{DynamicResource GearIcon}" Stretch="Uniform"
                    Width="17" Height="17" Fill="{DynamicResource AccentBright}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="1" Text="{loc:Tr settings.title}" FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="icon ghost" Content="✕"
                    FontSize="14" Command="{Binding CloseSettingsCommand}" />
          </Grid>

          <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Stroke}" />

          <ScrollViewer>
            <views:SettingsView DataContext="{Binding Settings}" />
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>
    <!-- =================================================================== title bar ==

         Last in the panel, so it draws over both overlays.

         That ordering is the point. A modal covers the window with a scrim, and if the caption
         buttons went under it there would be a state in which the program cannot be closed
         except through Alt+F4 or Task Manager. The window's own controls outrank anything the
         app has to say.                                                                       -->
    <Border Height="40" VerticalAlignment="Top"
            Background="Transparent"
            PointerPressed="TitleBarPressed"
            DoubleTapped="TitleBarDoubleTapped">
      <Grid ColumnDefinitions="Auto,*,Auto">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                    Margin="16,0,0,0" VerticalAlignment="Center">
          <Border Width="22" Height="22" CornerRadius="7"
                  Background="{DynamicResource AccentFill}">
            <Path Data="{DynamicResource MarkIcon}" Stretch="Uniform"
                  Width="9" Height="9" Fill="#FFFFFF"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Nostos" FontSize="13" FontWeight="Bold"
                     Foreground="{DynamicResource WordmarkFill}"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2"
                    Margin="0,0,8,0" VerticalAlignment="Center">
          <Button Classes="caption" Click="MinimiseClicked" ToolTip.Tip="{loc:Tr window.minimise}">
            <!-- 1.2 high, not 10: the bar has to fill its element or Uniform pins it to
                 the top and the glyph sits above the other two. -->
            <Path Data="{DynamicResource MinimiseIcon}" Stretch="Uniform"
                  Width="10" Height="1.2" />
          </Button>

          <!-- Its glyph and its tooltip are set from the window state in code behind, so the
               button says which of the two things it will do. -->
          <Button Name="MaximiseButton" Classes="caption" Click="MaximiseClicked">
            <Path Name="MaximiseGlyph" Data="{DynamicResource MaximiseIcon}"
                  Stretch="Uniform" Width="10" Height="10" />
          </Button>

          <Button Classes="caption close" Click="CloseClicked" ToolTip.Tip="{loc:Tr window.close}">
            <Path Data="{DynamicResource CloseIcon}" Stretch="Uniform"
                  Width="10" Height="10" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Panel>
</Window>
