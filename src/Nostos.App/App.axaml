<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Nostos.App.Views"
             x:Class="Nostos.App.App"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <FluentTheme />

    <!-- The app's own vocabulary: surfaces, text, chips and the two motions it uses. Loaded
         after Fluent so a class here can refine what a control theme set. -->
    <StyleInclude Source="avares://Nostos/Styles/Shared.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Colours, shape and icons. -->
        <ResourceInclude Source="avares://Nostos/Styles/Palette.axaml" />

        <!-- Control templates, which override Fluent's. In Resources rather than in Styles
             because that is the first place a control theme lookup looks, so these win
             without depending on the order Application.Styles happens to merge in. -->
        <ResourceInclude Source="avares://Nostos/Styles/Controls.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Value converters, at application scope rather than on the window.

           They live here because a StaticResource is resolved while the file that mentions it
           is being loaded, against that file's own tree and the application's, not against the
           window that will host the control later. A converter kept in Window.Resources is
           therefore invisible to every view split out of that window. -->
      <views:ResourceBrushConverter x:Key="BrushFromKey" />
      <views:ResourceGeometryConverter x:Key="GeometryFromKey" />
      <views:CategoryNameConverter x:Key="CategoryName" />
      <views:CategoryGroupHeaderConverter x:Key="CategoryGroupHeader" />
      <views:CategoryHasGroupHeaderConverter x:Key="CategoryHasGroupHeader" />
      <views:LocalizedCountConverter x:Key="LocalizedCount" />
      <views:BoolOpacityConverter x:Key="OpacityWhenTrue" />
      <views:InverseBoolOpacityConverter x:Key="OpacityWhenFalse" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
