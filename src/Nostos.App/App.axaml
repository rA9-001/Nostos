<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Nostos.App.App"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

  <Application.Resources>
    <!-- Risk and evidence colours are the app's whole visual vocabulary: the user should be
         able to tell a measured, safe tweak from an unproven one without reading a word. -->
    <SolidColorBrush x:Key="RiskSafe">#4ade80</SolidColorBrush>
    <SolidColorBrush x:Key="RiskModerate">#fbbf24</SolidColorBrush>
    <SolidColorBrush x:Key="RiskHigh">#f87171</SolidColorBrush>

    <SolidColorBrush x:Key="EvidenceMeasured">#4ade80</SolidColorBrush>
    <SolidColorBrush x:Key="EvidencePlausible">#94a3b8</SolidColorBrush>

    <SolidColorBrush x:Key="Accent">#60a5fa</SolidColorBrush>
    <SolidColorBrush x:Key="Muted">#94a3b8</SolidColorBrush>
    <SolidColorBrush x:Key="PanelBackground">#1b1f27</SolidColorBrush>
    <SolidColorBrush x:Key="PanelBorder">#2c3341</SolidColorBrush>
  </Application.Resources>
</Application>
