{
  "name": "conservative",
  "description": "FPS and interruptions only. Everything here has a mechanism you can point at, needs no reboot, and is rated Safe. The one to apply if you want the machine tidied up without thinking about it.",
  "tweaks": [
    {
      "tweakId": "gamedvr.policy-off"
    },
    {
      "tweakId": "gamedvr.user-capture-off"
    },
    {
      "tweakId": "mmcss.system-responsiveness",
      "options": {
        "reserve": "balanced"
      }
    },
    {
      "tweakId": "shell.game-mode",
      "options": {
        "state": "on"
      }
    },
    {
      "tweakId": "shell.background-apps-off"
    },
    {
      "tweakId": "input.mouse-acceleration-off"
    },
    {
      "tweakId": "update.no-auto-restart"
    },
    {
      "tweakId": "shell.suggestions-off"
    },
    {
      "tweakId": "shell.visual-effects"
    }
  ]
}
